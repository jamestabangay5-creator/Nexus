# NEXUS 911 — Environment Variables Template
# Copy these key-value pairs into your local .env or Vercel Project Settings:
# Settings -> Environment Variables -> Add New
# SECURITY WARNING: DO NOT put real API keys, tokens, or credentials in this file.

# Firebase Web Client Configuration (Required for Realtime Firestore Sync & Auth)
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"

# Optional Gemini API Key (if using AI dispatch features in the future)
GEMINI_API_KEY=""

# Application Host URL (e.g. https://nexus-seven-eosin-65.vercel.app)
APP_URL="https://nexus-seven-eosin-65.vercel.app"
